# تراپو — ریشه وب (فقط همین پوشه)
Require all granted
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset utf-8

# فایل‌های نقطه‌دار و پشتیبان هرگز
<FilesMatch "(^\.|\.(bak|sql|sqlite|log|ini|sh|md|json~)$)">
  Require all denied
</FilesMatch>
<Files "manifest.json">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|woff2|png|svg|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # همه چیز روی HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # موتورهای جست‌وجو: robots.txt و sitemap.xml با نشانی همین سایت (seo.php)
  RewriteRule ^robots\.txt$ seo.php?f=robots [L]
  RewriteRule ^sitemap\.xml$ seo.php?f=sitemap [L]
</IfModule>
